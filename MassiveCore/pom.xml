<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Parent -->
    <parent>
        <groupId>com.massivecraft.massivesuper</groupId>
        <artifactId>MassiveSuper</artifactId>
        <version>3.4.0-alpha-14</version>
        <relativePath>../MassiveSuper</relativePath>
    </parent>

    <!-- Basics -->
    <groupId>com.massivecraft.massivecore</groupId>
    <artifactId>MassiveCore</artifactId>
    <packaging>jar</packaging>

    <!-- Info -->
    <name>${project.artifactId}</name>
    <description>${massiveColorInfo}${project.name} is a plugin that contains libraries and features that other plugins make use of. ${massiveDescriptionSuffix}</description>
    <url>${massiveBaseUrl}/massivecore</url>

    <!-- Dependencies -->
    <dependencies>
        <!-- Spigot -->
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
        </dependency>
        <dependency>
		    <groupId>com.googlecode.json-simple</groupId>
		    <artifactId>json-simple</artifactId>
		    <version>1.1.1</version>
		</dependency>
        <!-- Gson -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <!-- Vault -->
        <dependency>
            <groupId>net.milkbowl.vault</groupId>
            <artifactId>Vault</artifactId>
        </dependency>
        <!-- MongoDB -->
        <dependency>
          <groupId>org.mongodb</groupId>
          <artifactId>mongo-java-driver</artifactId>
          <version>2.14.0</version>
        </dependency>
    </dependencies>

    <!-- Build -->
    <build>
        <!-- Plugins-->
        <plugins>
            <!-- Enforcer -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
            </plugin>
            <!-- Shade -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>shade-massivecore</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <includes>
                                    <include>com.massivecraft.massivecore:MassiveCoreXlib</include>
                                    <include>com.google.code.gson:gson</include>
                                </includes>
                            </artifactSet>
                            <!-- Relocate bundled Gson; shade rewrites MassiveCore internals. Dependent plugins use
                                 com.massivecraft.massivecore.gson (wrappers); com.google.gson in MassiveCore sources becomes lib.gson in the JAR. -->
                            <relocations>
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>com.massivecraft.massivecore.lib.gson</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <!-- Resources -->
        <resources>
            <!-- Build-time URLs for MassiveUpdateVersions (MassiveSuper: massiveReleasesUrl, massiveRepositoryUrl) -->
            <resource>
                <directory>${project.basedir}/src</directory>
                <filtering>true</filtering>
                <includes>
                    <include>massivecraft.properties</include>
                </includes>
            </resource>
            <!-- Standard -->
            <resource>
                <directory>${project.basedir}</directory>
                <filtering>true</filtering>
                <includes>
                    <include>*.yml</include>
                </includes>
            </resource>
            <!-- OpenSource -->
            <resource>
                <directory>${project.build.sourceDirectory}</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </resource>
            <!-- Sponsor Disable Code -->
            <resource>
                <directory>${project.basedir}</directory>
                <filtering>true</filtering>
                <includes>
                    <include>sponsor-disable-code</include>
                </includes>
            </resource>
        </resources>
    </build>

    <!--
         Bundle PluginUpdateChecker when the artifact is already in your local repo (e.g. after: mvn install in that project).
         Maven cannot "try download and continue if missing" for a compile dependency - if the profile is on and the
         artifact is absent, the build fails. So activation is file-based on the installed JAR.

         Auto activation caveat: Maven does NOT interpolate custom POM properties (e.g. ${massivePluginUpdateCheckerVersion})
         inside <activation><file><exists> - those stay literal, so the path never matched disk. The version segment in
         <exists> is therefore spelled out and must be kept in sync with MassiveSuper property massivePluginUpdateCheckerVersion.

         - Auto-on: JAR exists at the path below (uses ${user.home}; custom localRepository needs mvn -P bundle-update-checker).
         - Force-on: mvn -P bundle-update-checker (e.g. if file activation fails in an edge-case Maven build).
         - Force-off: remove/rename that JAR so the path no longer exists.

         Sources: update-checker-bundled/java (outside src/) so the parent sourceDirectory does not compile them unless this profile runs.
    -->
    <profiles>
        <profile>
            <id>bundle-update-checker</id>
            <activation>
                <file>
                    <!-- Sync directory + filename with MassiveSuper massivePluginUpdateCheckerVersion (not expandable here). -->
                    <exists>${user.home}/.m2/repository/com/failprooftech/plugin-update-checker/1.0.0/plugin-update-checker-1.0.0.jar</exists>
                </file>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.failprooftech</groupId>
                    <artifactId>plugin-update-checker</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.apache.maven</groupId>
                    <artifactId>maven-artifact</artifactId>
                    <version>3.9.6</version>
                </dependency>
                <dependency>
                    <groupId>org.codehaus.plexus</groupId>
                    <artifactId>plexus-utils</artifactId>
                    <version>3.5.1</version>
                </dependency>
                <dependency>
                    <groupId>org.apache.commons</groupId>
                    <artifactId>commons-lang3</artifactId>
                    <version>3.12.0</version>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>add-update-checker-bundled-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/update-checker-bundled/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>shade-massivecore</id>
                                <configuration combine.children="merge">
                                    <artifactSet combine.children="merge">
                                        <includes combine.children="append">
                                            <include>com.failprooftech:plugin-update-checker</include>
                                            <include>org.apache.maven:maven-artifact</include>
                                            <include>org.codehaus.plexus:plexus-utils</include>
                                            <include>org.apache.commons:commons-lang3</include>
                                        </includes>
                                    </artifactSet>
                                    <relocations combine.children="append">
                                        <relocation>
                                            <pattern>com.failprooftech.pluginupdatechecker</pattern>
                                            <shadedPattern>com.massivecraft.massivecore.lib.pluginupdatechecker</shadedPattern>
                                        </relocation>
                                        <!-- Whole org.apache.maven tree from maven-artifact (artifact, artifact.repository, etc.) -->
                                        <relocation>
                                            <pattern>org.apache.maven</pattern>
                                            <shadedPattern>com.massivecraft.massivecore.lib.maven</shadedPattern>
                                        </relocation>
                                        <relocation>
                                            <pattern>org.codehaus.plexus</pattern>
                                            <shadedPattern>com.massivecraft.massivecore.lib.plexus</shadedPattern>
                                        </relocation>
                                        <relocation>
                                            <pattern>org.apache.commons.lang3</pattern>
                                            <shadedPattern>com.massivecraft.massivecore.lib.commons.lang3</shadedPattern>
                                        </relocation>
                                    </relocations>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
