<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  
    <!-- Parent -->
    <parent>
        <groupId>com.massivecraft.massivesuper</groupId>
        <artifactId>MassiveSuper</artifactId>
        <version>3.4.2</version>
        <relativePath>../MassiveSuper</relativePath>
    </parent>

    <!-- Basics -->
    <groupId>com.failprooftech.factionschat</groupId>
    <artifactId>FactionsChat</artifactId>
    <packaging>jar</packaging>

    <!-- Info -->
    <name>${project.artifactId}</name>
    <description>${massiveColorInfo}${project.name} allows players to chat in different channels, including global chat, their faction, allies, and more. ${massiveDescriptionSuffix}</description>
    <url>${massiveBaseUrl}/factionschat</url>
    
    <!-- Dependencies -->
    <dependencies>
        <!-- Paper before Spigot so compile-time org.bukkit.Server resolves Paper (e.g. Adventure broadcast).
             Compile target is 1.21.7+; Paper 1.21.4–1.21.6 is soft-supported at runtime via login pipeline fallback. -->
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
        </dependency>
        <!-- MiniMessage -->
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-minimessage</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- MassiveCore -->
        <dependency>
            <groupId>com.massivecraft.massivecore</groupId>
            <artifactId>MassiveCore</artifactId>
        </dependency>
        <!-- Factions -->
        <dependency>
            <groupId>com.massivecraft.factions</groupId>
            <artifactId>Factions</artifactId>
        </dependency>
        <!-- DiscordSRV -->
        <dependency>
            <groupId>com.discordsrv</groupId>
            <artifactId>discordsrv</artifactId>
        </dependency>
        <!-- Essentials -->
        <dependency>
            <groupId>net.ess3</groupId>
            <artifactId>EssentialsX</artifactId>
        </dependency>
        <!-- PlaceholderAPI -->
        <dependency>
          <groupId>me.clip</groupId>
          <artifactId>placeholderapi</artifactId>
        </dependency>
        <!-- TeamsAPI (library module; not com.github.ez-plugins:teams-api aggregator) -->
        <dependency>
            <groupId>com.github.ez-plugins.teams-api</groupId>
            <artifactId>teams-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- PvPIndex Factions (soft integration) -->
        <dependency>
            <groupId>com.github.PVP-Index</groupId>
            <artifactId>pvpindex-factions</artifactId>
            <version>v1.1.0</version>
            <scope>provided</scope>
        </dependency>
        <!-- FactionsBridge (standalone plugin; compile-only; ${massiveFactionsBridgeApiVersion} from Failproof Tech repo) -->
        <dependency>
            <groupId>cc.javajobs.factionsbridge</groupId>
            <artifactId>FactionsBridge-API</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- bStats (shaded in and relocated under com.failprooftech.factionschat.lib.bstats) -->
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-bukkit</artifactId>
        </dependency>
        <!-- Required at package time: shade artifactSet does not always pull bstats-base transitively -->
        <dependency>
            <groupId>org.bstats</groupId>
            <artifactId>bstats-base</artifactId>
        </dependency>

        <!-- Unit tests (MockBukkit artifact chosen by paperTestLine profile below) -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${factionschat.junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${factionschat.mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Explicit agent for MockBukkit ByteBuddy class injection on JDK 17+ / 25 -->
        <dependency>
            <groupId>net.bytebuddy</groupId>
            <artifactId>byte-buddy-agent</artifactId>
            <version>${factionschat.bytebuddy.agent.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
            MockBukkit (1.21 and 26) needs Guava 21+ (ImmutableMap.ofEntries).
            paper-api 1.21 still pulls Guava 23.5 onto the test classpath otherwise.
        -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${factionschat.test.guava.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    
    <!-- Build -->
    <properties>
        <!-- Isolated compile of adventure5-bundled (Paper 26.x). Keep in sync with Paper's Adventure when bumping. -->
        <factionschat.adventure5.version>5.2.0</factionschat.adventure5.version>
        <factionschat.junit.version>5.11.4</factionschat.junit.version>
        <factionschat.mockito.version>5.14.2</factionschat.mockito.version>
        <factionschat.mockbukkit.v21.version>4.110.0</factionschat.mockbukkit.v21.version>
        <factionschat.mockbukkit.v26.version>4.114.0</factionschat.mockbukkit.v26.version>
        <!-- Must match MockBukkit-v1.21 MANIFEST Paper-Version. -->
        <factionschat.paper21.api.version>1.21.11-R0.1-SNAPSHOT</factionschat.paper21.api.version>
        <!-- Must match MockBukkit-v26.1.2 MANIFEST Paper-Version (see jar META-INF/MANIFEST.MF). -->
        <factionschat.paper26.api.version>26.1.2.build.72-stable</factionschat.paper26.api.version>
        <!--
            Adventure line used by MockBukkit's paper-api for both 1.21.11 and 26.1.2 test swaps
            (adventure-bom 4.26.1). Not Adventure 5 — that is only for adventure5-bundled compile.
        -->
        <factionschat.mockbukkit.adventure.version>4.26.1</factionschat.mockbukkit.adventure.version>
        <!-- Shared test Guava (MockBukkit ofEntries); paper26 profile also copies this jar when excluding transitive Guava. -->
        <factionschat.test.guava.version>33.5.0-jre</factionschat.test.guava.version>
        <factionschat.surefire.version>3.5.2</factionschat.surefire.version>
        <!-- Keep in sync with MockBukkit-v26.1.2 byte-buddy (see its POM). -->
        <factionschat.bytebuddy.agent.version>1.18.10</factionschat.bytebuddy.agent.version>
    </properties>
    <build>
        <plugins>
            <!--
                Adventure 4 (Paper 1.21.x via paper-api) and Adventure 5 (Paper 26.x) cannot share one compile
                classpath: ClickEvent.Action.OPEN_URL changed field descriptor (enum -> Action.OpenUrl).
                Main sources compile against Adventure 4. Adventure5ActionBridge is javac'd separately against
                Adventure 5 jars from adventure5-bundled/java (outside src/, same idea as update-checker-bundled),
                then written into target/classes. Runtime picks one bridge via Class.forName
                (same pattern as Paper vs Spigot listeners).
                TODO(adventure4-drop): Remove this dependency-plugin + antrun pair and adventure5-bundled when
                Adventure 4 support is dropped; keep a single Adventure 5 code path.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.6.1</version>
                <executions>
                    <execution>
                        <id>copy-adventure5-compile-classpath</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/adventure5-cp</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>net.kyori</groupId>
                                    <artifactId>adventure-api</artifactId>
                                    <version>${factionschat.adventure5.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>net.kyori</groupId>
                                    <artifactId>adventure-key</artifactId>
                                    <version>${factionschat.adventure5.version}</version>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.jspecify</groupId>
                                    <artifactId>jspecify</artifactId>
                                    <version>1.0.0</version>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>compile-adventure5-bridge</id>
                        <!-- Must be compile (not process-classes): `mvn compile` does not run process-classes. -->
                        <phase>compile</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <path id="factionschat.adventure5.classpath">
                                    <pathelement location="${project.build.outputDirectory}"/>
                                    <fileset dir="${project.build.directory}/adventure5-cp" includes="*.jar"/>
                                </path>
                                <javac srcdir="${project.basedir}/adventure5-bundled/java"
                                       destdir="${project.build.outputDirectory}"
                                       classpathref="factionschat.adventure5.classpath"
                                       includeantruntime="false"
                                       encoding="UTF-8"
                                       release="${massiveJavaVersion}"
                                       includes="**/Adventure5ActionBridge.java"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <id>shade-factionschat-bstats</id>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <includes>
                                    <include>org.bstats:bstats-bukkit</include>
                                    <include>org.bstats:bstats-base</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>org.bstats</pattern>
                                    <shadedPattern>com.failprooftech.factionschat.lib.bstats</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <!--
                        MassiveSuper uses sourceDirectory=src (not src/main/java), so tests must live
                        outside src/ (test/java). Cursor / VS Code Java often ignores a lone
                        <testSourceDirectory>; add-test-source registers the root for the language server.
                    -->
                    <execution>
                        <id>add-factionschat-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals>
                            <goal>add-test-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.basedir}/test/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <!--
                        MockBukkit.load(Class) needs the plugin packaged as a JAR (CodeSource must be a
                        .jar URL), but jar runs at package — after test. Re-phase the built-in execution
                        rather than adding a second one: a second unclassified jar execution fails with
                        "use a classifier to attach supplemental artifacts". Shade still runs at package
                        and replaces this artifact. Nothing writes target/classes after compile, so the
                        earlier jar has complete contents.
                    -->
                    <execution>
                        <id>default-jar</id>
                        <phase>process-test-classes</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${factionschat.surefire.version}</version>
                <configuration>
                    <!-- Avoid parallel MockBukkit servers stomping Bukkit statics -->
                    <forkCount>1</forkCount>
                    <reuseForks>false</reuseForks>
                    <systemPropertyVariables>
                        <factionschat.test.pluginJar>${project.build.directory}/${project.build.finalName}.jar</factionschat.test.pluginJar>
                    </systemPropertyVariables>
                    <!--
                        MockBukkit.load(Class) injects a ByteBuddy proxy into ConfiguredPluginClassLoader.
                        On JDK 17+ that injector is unavailable unless these packages are opened; otherwise
                        findClass runs and throws "No jar file selected".
                    -->
                    <argLine>-Dnet.bytebuddy.experimental=true -javaagent:${user.home}/.m2/repository/net/bytebuddy/byte-buddy-agent/${factionschat.bytebuddy.agent.version}/byte-buddy-agent-${factionschat.bytebuddy.agent.version}.jar -XX:+EnableDynamicAgentLoading -Djdk.attach.allowAttachSelf=true --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/jdk.internal.loader=ALL-UNNAMED --add-opens=java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
        <testSourceDirectory>${project.basedir}/test/java</testSourceDirectory>
        <!-- Resources -->
        <resources>
            <!-- Standard -->
            <resource>
                <directory>${project.basedir}</directory>
                <filtering>true</filtering>
                <includes>
                    <include>*.yml</include>
                </includes>
            </resource>
            <!-- OpenSource -->
            <resource>
                <directory>${project.build.sourceDirectory}</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>**/*.java</exclude>
                </excludes>
            </resource>
        </resources>
    </build>

    <!--
         Bundle PluginUpdateChecker when the artifact is already in your local repo (e.g. after: mvn install in that project).
         Maven cannot "try download and continue if missing" for a compile dependency - if the profile is on and the
         artifact is absent, the build fails. So activation is file-based on the installed JAR.

         Auto activation caveat: Maven does NOT interpolate custom POM properties (e.g. ${massivePluginUpdateCheckerVersion})
         inside <activation><file><exists> - those stay literal, so the path never matched disk. The version segment in
         <exists> is therefore spelled out and must be kept in sync with MassiveSuper property massivePluginUpdateCheckerVersion.

         - Auto-on: JAR exists at the path below (uses ${user.home}; custom localRepository needs mvn -P bundle-update-checker).
         - Force-on: mvn -P bundle-update-checker (e.g. if file activation fails in an edge-case Maven build).
         - Force-off: remove/rename that JAR so the path no longer exists.

         Sources: update-checker-bundled/java (outside src/) so the parent sourceDirectory does not compile them unless this profile runs.
    -->
    <profiles>
        <!--
            MockBukkit cannot put 1.21 and 26.x on one classpath (Paper/Adventure conflict).
            Default: -DpaperTestLine=26 (or omit). Alternate: -DpaperTestLine=1.21
            Helper: scripts/run-tests.ps1 / scripts/run-tests.sh
        -->
        <profile>
            <id>test-paper-26</id>
            <activation>
                <!--
                    Negated value, not <value>26</value>: profile activation only reads -D / system
                    properties (never POM <properties>), so an explicit 26 would leave plain
                    `mvn install` and the IDE language server without MockBukkit on the test
                    classpath. !1.21 keeps this line on unless the 1.21 profile is requested.
                -->
                <property>
                    <name>paperTestLine</name>
                    <value>!1.21</value>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.mockbukkit.mockbukkit</groupId>
                    <artifactId>mockbukkit-v26.1.2</artifactId>
                    <version>${factionschat.mockbukkit.v26.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <!--
                        Main compile stays on Paper 1.21 / Adventure 4 (Adventure4ActionBridge).
                        Surefire drops that paper-api / older Guava / Adv jars and uses Paper 26 +
                        Adventure 4.26 (MockBukkit line) + Guava 33 from target/paper26-test-cp.
                        Replace the full Adventure stack so Adv serializers match adventure-api.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-paper26-test-api</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/paper26-test-cp</outputDirectory>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>io.papermc.paper</groupId>
                                            <artifactId>paper-api</artifactId>
                                            <version>${factionschat.paper26.api.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>com.google.guava</groupId>
                                            <artifactId>guava</artifactId>
                                            <version>${factionschat.test.guava.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>net.kyori</groupId>
                                            <artifactId>adventure-api</artifactId>
                                            <version>${factionschat.mockbukkit.adventure.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>net.kyori</groupId>
                                            <artifactId>adventure-key</artifactId>
                                            <version>${factionschat.mockbukkit.adventure.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>net.kyori</groupId>
                                            <artifactId>adventure-text-minimessage</artifactId>
                                            <version>${factionschat.mockbukkit.adventure.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>net.kyori</groupId>
                                            <artifactId>adventure-text-serializer-plain</artifactId>
                                            <version>${factionschat.mockbukkit.adventure.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>net.kyori</groupId>
                                            <artifactId>adventure-text-serializer-legacy</artifactId>
                                            <version>${factionschat.mockbukkit.adventure.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>net.kyori</groupId>
                                            <artifactId>adventure-text-serializer-gson</artifactId>
                                            <version>${factionschat.mockbukkit.adventure.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>net.kyori</groupId>
                                            <artifactId>adventure-text-serializer-commons</artifactId>
                                            <version>${factionschat.mockbukkit.adventure.version}</version>
                                        </artifactItem>
                                    </artifactItems>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <systemPropertyVariables>
                                <factionschat.test.pluginJar>${project.build.directory}/${project.build.finalName}.jar</factionschat.test.pluginJar>
                            </systemPropertyVariables>
                            <!-- Profile config replaces base surefire config; keep JDK opens for MockBukkit ByteBuddy. -->
                            <argLine>-Dnet.bytebuddy.experimental=true -javaagent:${user.home}/.m2/repository/net/bytebuddy/byte-buddy-agent/${factionschat.bytebuddy.agent.version}/byte-buddy-agent-${factionschat.bytebuddy.agent.version}.jar -XX:+EnableDynamicAgentLoading -Djdk.attach.allowAttachSelf=true --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/jdk.internal.loader=ALL-UNNAMED --add-opens=java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
                            <classpathDependencyExcludes>
                                <classpathDependencyExclude>io.papermc.paper:paper-api</classpathDependencyExclude>
                                <classpathDependencyExclude>org.spigotmc:spigot-api</classpathDependencyExclude>
                                <classpathDependencyExclude>com.google.guava:guava</classpathDependencyExclude>
                                <classpathDependencyExclude>net.kyori:adventure-api</classpathDependencyExclude>
                                <classpathDependencyExclude>net.kyori:adventure-key</classpathDependencyExclude>
                                <classpathDependencyExclude>net.kyori:adventure-text-minimessage</classpathDependencyExclude>
                                <classpathDependencyExclude>net.kyori:adventure-text-serializer-plain</classpathDependencyExclude>
                                <classpathDependencyExclude>net.kyori:adventure-text-serializer-legacy</classpathDependencyExclude>
                                <classpathDependencyExclude>net.kyori:adventure-text-serializer-gson</classpathDependencyExclude>
                                <classpathDependencyExclude>net.kyori:adventure-text-serializer-commons</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                            <additionalClasspathElements>
                                <additionalClasspathElement>${project.build.directory}/paper26-test-cp/paper-api-${factionschat.paper26.api.version}.jar</additionalClasspathElement>
                                <additionalClasspathElement>${project.build.directory}/paper26-test-cp/guava-${factionschat.test.guava.version}.jar</additionalClasspathElement>
                                <additionalClasspathElement>${project.build.directory}/paper26-test-cp/adventure-api-${factionschat.mockbukkit.adventure.version}.jar</additionalClasspathElement>
                                <additionalClasspathElement>${project.build.directory}/paper26-test-cp/adventure-key-${factionschat.mockbukkit.adventure.version}.jar</additionalClasspathElement>
                                <additionalClasspathElement>${project.build.directory}/paper26-test-cp/adventure-text-minimessage-${factionschat.mockbukkit.adventure.version}.jar</additionalClasspathElement>
                                <additionalClasspathElement>${project.build.directory}/paper26-test-cp/adventure-text-serializer-plain-${factionschat.mockbukkit.adventure.version}.jar</additionalClasspathElement>
                                <additionalClasspathElement>${project.build.directory}/paper26-test-cp/adventure-text-serializer-legacy-${factionschat.mockbukkit.adventure.version}.jar</additionalClasspathElement>
                                <additionalClasspathElement>${project.build.directory}/paper26-test-cp/adventure-text-serializer-gson-${factionschat.mockbukkit.adventure.version}.jar</additionalClasspathElement>
                                <additionalClasspathElement>${project.build.directory}/paper26-test-cp/adventure-text-serializer-commons-${factionschat.mockbukkit.adventure.version}.jar</additionalClasspathElement>
                            </additionalClasspathElements>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>test-paper-1.21</id>
            <activation>
                <property>
                    <name>paperTestLine</name>
                    <value>1.21</value>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.mockbukkit.mockbukkit</groupId>
                    <artifactId>mockbukkit-v1.21</artifactId>
                    <version>${factionschat.mockbukkit.v21.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <!--
                        Main compile may use a different 1.21.x paper-api than MockBukkit-v1.21 expects
                        (Paper-Version in its MANIFEST). Surefire swaps to the MockBukkit-matched API jar.
                    -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>copy-paper21-test-api</id>
                                <phase>generate-test-resources</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/paper21-test-cp</outputDirectory>
                                    <artifactItems>
                                        <artifactItem>
                                            <groupId>io.papermc.paper</groupId>
                                            <artifactId>paper-api</artifactId>
                                            <version>${factionschat.paper21.api.version}</version>
                                            <destFileName>paper-api-${factionschat.paper21.api.version}.jar</destFileName>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>net.kyori</groupId>
                                            <artifactId>adventure-api</artifactId>
                                            <version>${factionschat.mockbukkit.adventure.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>net.kyori</groupId>
                                            <artifactId>adventure-key</artifactId>
                                            <version>${factionschat.mockbukkit.adventure.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>net.kyori</groupId>
                                            <artifactId>adventure-text-minimessage</artifactId>
                                            <version>${factionschat.mockbukkit.adventure.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>net.kyori</groupId>
                                            <artifactId>adventure-text-serializer-plain</artifactId>
                                            <version>${factionschat.mockbukkit.adventure.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>net.kyori</groupId>
                                            <artifactId>adventure-text-serializer-legacy</artifactId>
                                            <version>${factionschat.mockbukkit.adventure.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>net.kyori</groupId>
                                            <artifactId>adventure-text-serializer-gson</artifactId>
                                            <version>${factionschat.mockbukkit.adventure.version}</version>
                                        </artifactItem>
                                        <artifactItem>
                                            <groupId>net.kyori</groupId>
                                            <artifactId>adventure-text-serializer-commons</artifactId>
