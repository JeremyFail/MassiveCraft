                            <argLine>-Dnet.bytebuddy.experimental=true -javaagent:${user.home}/.m2/repository/net/bytebuddy/byte-buddy-agent/${factionschat.bytebuddy.agent.version}/byte-buddy-agent-${factionschat.bytebuddy.agent.version}.jar -XX:+EnableDynamicAgentLoading -Djdk.attach.allowAttachSelf=true --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.lang.reflect=ALL-UNNAMED --add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.util=ALL-UNNAMED --add-opens=java.base/jdk.internal.loader=ALL-UNNAMED --add-opens=java.base/jdk.internal.misc=ALL-UNNAMED</argLine>
                            <classpathDependencyExcludes>
