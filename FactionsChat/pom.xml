                                <additionalClasspathElement>${project.build.directory}/paper21-test-cp/adventure-api-${factionschat.mockbukkit.adventure.version}.jar</additionalClasspathElement>
                                <additionalClasspathElement>${project.build.directory}/paper21-test-cp/adventure-key-${factionschat.mockbukkit.adventure.version}.jar</additionalClasspathElement>
                                <additionalClasspathElement>${project.build.directory}/paper21-test-cp/adventure-text-minimessage-${factionschat.mockbukkit.adventure.version}.jar</additionalClasspathElement>
                                <additionalClasspathElement>${project.build.directory}/paper21-test-cp/adventure-text-serializer-plain-${factionschat.mockbukkit.adventure.version}.jar</additionalClasspathElement>
